# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Production sets these as App Platform environment variables instead
# (see "Production deployment" in PLAN.md).

# ---- Database ----------------------------------------------------------------
# Local Postgres (see server/README.md), or Neon's pooled URL (host has -pooler)
DATABASE_URL=postgres://apex:<password>@127.0.0.1:5432/apex_grips
# Only used by Medusa's own setup commands
DB_NAME=apex_grips

# ---- Redis -------------------------------------------------------------------
# Not read by medusa-config.ts yet; Medusa uses in-memory stand-ins
REDIS_URL=redis://localhost:6379

# ---- CORS: which sites may call this server ----------------------------------------
# Storefront dev server (client/vite.config.ts) on 8000; admin is served on 9000
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:8000

# ---- Secrets -------------------------------------------------------------------------
# Generate each with `openssl rand -hex 32`. Use different values in production.
JWT_SECRET=<random-hex>
COOKIE_SECRET=<random-hex>
AUTH_MFA_ENCRYPTION_KEY=<random-hex>

# ---- Admin -------------------------------------------------------------------------
# Public URL of this server; baked into the admin at build time. Defaults to
# http://localhost:9000 when unset. Production: https://api.apexgrips.in
# MEDUSA_BACKEND_URL=
MEDUSA_ADMIN_ONBOARDING_TYPE=default

# ---- Razorpay ----------------------------------------------------------------------
# Dashboard → Account & Settings → API Keys. Use test keys (rzp_test_…) locally.
# Leave RAZORPAY_KEY_ID empty to start without Razorpay (only cash on delivery).
RAZORPAY_KEY_ID=rzp_test_<key-id>
RAZORPAY_KEY_SECRET=<key-secret>
# Secret set on the webhook in the dashboard; webhooks are ignored until it's set
RAZORPAY_WEBHOOK_SECRET=
