# Used by `npm run build`. These values end up in the public JavaScript bundle,
# so never put secrets here. The publishable key is public: it only scopes store
# API requests to a sales channel.
VITE_MEDUSA_BACKEND_URL=https://api.apexgrips.in
# Region whose currency and prices the store shows (ISO 3166-1 alpha-2)
VITE_MEDUSA_REGION_COUNTRY=in
# Publishable key of the production database (Neon Singapore)
VITE_MEDUSA_PUBLISHABLE_KEY=pk_43f7acb21d25109cdfb0243e12daced080a47b1e8497f6d7cd746aa0288fb00a
